{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/let778750-cpu/autofigure/.github/governance-contract.schema.json",
  "title": "Autofigure head-bound governance contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_kind",
    "repository",
    "pr_number",
    "base_ref",
    "base_sha",
    "head_ref",
    "pr_type",
    "risk_level",
    "epic",
    "stage",
    "included_issues",
    "deferred_issues",
    "issue_snapshots",
    "scope_freeze",
    "branch_sunset",
    "evidence_invalidation",
    "rollback_unit",
    "accountable_owner",
    "implementation_agent",
    "independent_pr_author",
    "workstream",
    "scientific_mode",
    "closure_state",
    "release_preparation",
    "scope_threshold_justification"
  ],
  "allOf": [
    {
      "if": {"properties": {"contract_kind": {"const": "release"}}},
      "then": {
        "properties": {
          "scope_freeze": {"const": "current-head"},
          "release_preparation": {"type": "object"}
        }
      }
    },
    {
      "if": {"properties": {"contract_kind": {"const": "stage"}}},
      "then": {
        "properties": {
          "scope_freeze": {"pattern": "^scope@[0-9a-f]{40}$"},
          "release_preparation": {"type": "null"}
        }
      }
    }
  ],
  "properties": {
    "schema_version": {"const": 1},
    "contract_kind": {"enum": ["stage", "release"]},
    "repository": {"const": "let778750-cpu/autofigure"},
    "pr_number": {"type": "integer", "minimum": 1},
    "base_ref": {"enum": ["develop", "main"]},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "head_ref": {"type": "string", "minLength": 1},
    "pr_type": {"enum": ["feature", "task-definition", "integration", "release"]},
    "risk_level": {"enum": ["R0", "R1", "R2"]},
    "epic": {"type": "string", "pattern": "^(?:#[1-9][0-9]*|release)$"},
    "stage": {"type": "string", "pattern": "^[a-z][a-z0-9-]*@v[1-9][0-9]*$"},
    "included_issues": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "deferred_issues": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "issue_snapshots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "number",
          "role",
          "node_id",
          "last_edited_at",
          "title_sha256",
          "body_sha256",
          "labels_sha256",
          "managed_event_cursor"
        ],
        "properties": {
          "number": {"type": "integer", "minimum": 1},
          "role": {"enum": ["epic", "included", "deferred"]},
          "node_id": {"type": "string", "minLength": 1},
          "last_edited_at": {
            "oneOf": [
              {"type": "null"},
              {"type": "string", "format": "date-time"}
            ]
          },
          "title_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "body_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "labels_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "managed_event_cursor": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "event", "created_at"],
                "properties": {
                  "id": {"type": "integer", "minimum": 1},
                  "event": {
                    "enum": [
                      "closed",
                      "labeled",
                      "renamed",
                      "reopened",
                      "transferred",
                      "unlabeled"
                    ]
                  },
                  "created_at": {"type": "string", "format": "date-time"}
                }
              }
            ]
          }
        }
      }
    },
    "scope_freeze": {
      "type": "string",
      "pattern": "^(?:scope@[0-9a-f]{40}|current-head)$"
    },
    "branch_sunset": {"type": "string", "minLength": 1},
    "evidence_invalidation": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "rollback_unit": {"enum": ["stage-squash", "release-merge"]},
    "accountable_owner": {"type": "string", "pattern": "^@[^\\s]+$"},
    "implementation_agent": {"type": "string", "minLength": 1},
    "independent_pr_author": {"type": "string", "pattern": "^@[^\\s]+$"},
    "workstream": {"type": "string", "minLength": 1},
    "scientific_mode": {
      "enum": ["RECONSTRUCT_1TO1", "NEW_OR_REDESIGN", "NOT_APPLICABLE"]
    },
    "closure_state": {"const": "ready"},
    "release_preparation": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["pr_number", "base_sha"],
          "properties": {
            "pr_number": {"type": "integer", "minimum": 1},
            "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
          }
        }
      ]
    },
    "scope_threshold_justification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atomic_outcome",
        "shared_failure_mechanism",
        "shared_validation",
        "rollback_reason",
        "included_issues",
        "source_test_files",
        "non_generated_loc"
      ],
      "properties": {
        "atomic_outcome": {"type": "string"},
        "shared_failure_mechanism": {"type": "string"},
        "shared_validation": {"type": "string"},
        "rollback_reason": {"type": "string"},
        "included_issues": {"type": "string"},
        "source_test_files": {"type": "string"},
        "non_generated_loc": {"type": "string"}
      }
    }
  }
}
