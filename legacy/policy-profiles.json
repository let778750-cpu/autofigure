{
  "schema_version": "1.0.0",
  "default_profile": "standard",
  "profiles": {
    "standard": {
      "ocr": {
        "ordinary_consensus_enabled": true,
        "calibration_receipt_required": true,
        "minimum_fixture_precision": 0.995,
        "deterministic_sample_fraction": 0.1,
        "deterministic_sample_minimum": 3,
        "sample_failure_escalation": "region",
        "critical_roles": [
          "formula",
          "number_or_unit",
          "title",
          "axis_label",
          "legend_label",
          "connector_label"
        ]
      },
      "geometry": {
        "promotion_enabled": true,
        "calibration_receipt_required": true,
        "minimum_samples_per_class": 30,
        "maximum_median_error_px": 1.0,
        "maximum_p95_error_px": 2.0,
        "maximum_high_risk_false_promotions": 0,
        "promotable_classes": ["horizontal_single_line_ink_bbox", "clear_frame", "same_row_gap"]
      },
      "math": {
        "audit_mode": "conditional_strict",
        "fresh_render_count": 2,
        "retain_passing_control_images": false,
        "strict_triggers": [
          "occlusion_risk",
          "plain_text_masquerade_risk",
          "inline_order_mismatch",
          "z_order_risk",
          "readback_mismatch"
        ]
      },
      "assets": {
        "reference_atomic_asset_final_allowed": true,
        "generative_redraw_allowed": false,
        "compound_reference_preview_blocks_approval": true
      }
    },
    "strict": {
      "ocr": {
        "ordinary_consensus_enabled": false,
        "calibration_receipt_required": true,
        "minimum_fixture_precision": 1.0,
        "deterministic_sample_fraction": 1.0,
        "deterministic_sample_minimum": 1,
        "sample_failure_escalation": "run",
        "critical_roles": [
          "formula",
          "number_or_unit",
          "title",
          "axis_label",
          "legend_label",
          "connector_label"
        ]
      },
      "geometry": {
        "promotion_enabled": false,
        "calibration_receipt_required": true,
        "minimum_samples_per_class": 30,
        "maximum_median_error_px": 1.0,
        "maximum_p95_error_px": 2.0,
        "maximum_high_risk_false_promotions": 0,
        "promotable_classes": []
      },
      "math": {
        "audit_mode": "all_zones_strict",
        "fresh_render_count": 2,
        "retain_passing_control_images": true,
        "strict_triggers": ["all_math_zones"]
      },
      "assets": {
        "reference_atomic_asset_final_allowed": true,
        "generative_redraw_allowed": false,
        "compound_reference_preview_blocks_approval": true
      }
    }
  }
}
