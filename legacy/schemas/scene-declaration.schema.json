{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-autofigure/schemas/scene-declaration.schema.json",
  "title": "AI AutoFigure frozen scene declaration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_type",
    "mode",
    "source_authority",
    "perception_review",
    "canvas",
    "measurement_dpi",
    "elements",
    "edges",
    "formula_bindings",
    "uncertainties"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "document_type": {"const": "FIGURE_SCENE_DECLARATION"},
    "mode": {"enum": ["reconstruct_1to1", "publication_normalize"]},
    "source_authority": {"$ref": "#/$defs/fileBinding"},
    "perception_review": {"$ref": "#/$defs/fileBinding"},
    "geometry": {
      "oneOf": [{"$ref": "#/$defs/fileBinding"}, {"type": "null"}]
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "width_px", "height_px", "background", "background_evidence"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "width_px": {"type": "integer", "minimum": 1},
        "height_px": {"type": "integer", "minimum": 1},
        "background": {"type": "string", "pattern": "^#[A-Fa-f0-9]{6}$"},
        "background_evidence": {"enum": ["measured_reference", "intentional_deviation"]},
        "background_reason": {"type": "string", "minLength": 1}
      }
    },
    "measurement_dpi": {"type": "number", "exclusiveMinimum": 0},
    "policy_profile": {"enum": ["standard", "strict"]},
    "elements": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "edges": {"type": "array", "items": {"type": "object"}},
    "formula_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["authority_item_id", "formula_id", "element_id", "converter_receipt_path", "converter_receipt_sha256"],
        "properties": {
          "authority_item_id": {"type": "string", "pattern": "^AUTH-[0-9]{4}$"},
          "formula_id": {"type": "string", "minLength": 1},
          "element_id": {"type": "string", "minLength": 1},
          "converter_receipt_path": {"type": "string", "minLength": 1},
          "converter_receipt_sha256": {"$ref": "#/$defs/sha256"},
          "sequence_term_index": {"type": "integer", "minimum": 0},
          "perception_candidate_id": {"type": "string", "pattern": "^T[0-9]{4}$"}
        }
      }
    },
    "uncertainties": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
