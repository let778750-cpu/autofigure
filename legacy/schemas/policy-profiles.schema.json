{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-autofigure/schemas/policy-profiles.schema.json",
  "title": "AI AutoFigure policy profiles",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "default_profile", "profiles"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "default_profile": {"enum": ["standard", "strict"]},
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standard", "strict"],
      "properties": {
        "standard": {"$ref": "#/$defs/profile"},
        "strict": {"$ref": "#/$defs/profile"}
      }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ocr", "geometry", "math", "assets"],
      "properties": {
        "ocr": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ordinary_consensus_enabled", "calibration_receipt_required", "minimum_fixture_precision", "deterministic_sample_fraction", "deterministic_sample_minimum", "sample_failure_escalation", "critical_roles"],
          "properties": {
            "ordinary_consensus_enabled": {"type": "boolean"},
            "calibration_receipt_required": {"type": "boolean"},
            "minimum_fixture_precision": {"type": "number", "minimum": 0, "maximum": 1},
            "deterministic_sample_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
            "deterministic_sample_minimum": {"type": "integer", "minimum": 1},
            "sample_failure_escalation": {"enum": ["region", "run"]},
            "critical_roles": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        },
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["promotion_enabled", "calibration_receipt_required", "minimum_samples_per_class", "maximum_median_error_px", "maximum_p95_error_px", "maximum_high_risk_false_promotions", "promotable_classes"],
          "properties": {
            "promotion_enabled": {"type": "boolean"},
            "calibration_receipt_required": {"type": "boolean"},
            "minimum_samples_per_class": {"type": "integer", "minimum": 1},
            "maximum_median_error_px": {"type": "number", "minimum": 0},
            "maximum_p95_error_px": {"type": "number", "minimum": 0},
            "maximum_high_risk_false_promotions": {"type": "integer", "minimum": 0},
            "promotable_classes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        },
        "math": {
          "type": "object",
          "additionalProperties": false,
          "required": ["audit_mode", "fresh_render_count", "retain_passing_control_images", "strict_triggers"],
          "properties": {
            "audit_mode": {"enum": ["conditional_strict", "all_zones_strict"]},
            "fresh_render_count": {"const": 2},
            "retain_passing_control_images": {"type": "boolean"},
            "strict_triggers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        },
        "assets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reference_atomic_asset_final_allowed", "generative_redraw_allowed", "compound_reference_preview_blocks_approval"],
          "properties": {
            "reference_atomic_asset_final_allowed": {"const": true},
            "generative_redraw_allowed": {"const": false},
            "compound_reference_preview_blocks_approval": {"const": true}
          }
        }
      }
    }
  }
}
