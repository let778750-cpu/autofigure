{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-autofigure/schemas/geometry-calibration.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_type", "status", "fixture", "policy_profile", "classes"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "document_type": {"const": "GEOMETRY_CALIBRATION_RECEIPT"},
    "status": {"enum": ["PASS", "FAIL"]},
    "fixture": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "version", "legend_classes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
        "version": {"type": "string", "minLength": 1},
        "legend_classes": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "policy_profile": {"enum": ["standard", "strict"]},
    "classes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["class_id", "sample_count", "median_error_px", "p95_error_px", "high_risk_false_promotions", "status"],
        "properties": {
          "class_id": {"type": "string", "minLength": 1},
          "sample_count": {"type": "integer", "minimum": 1},
          "median_error_px": {"type": "number", "minimum": 0},
          "p95_error_px": {"type": "number", "minimum": 0},
          "high_risk_false_promotions": {"type": "integer", "minimum": 0},
          "status": {"enum": ["PROMOTABLE", "OBSERVATION_ONLY"]}
        }
      }
    }
  }
}
