# Hash-bound scene, manifest, binding, and QA contracts require stable bytes.
*.json text eol=lf
# Benchmark fixtures are hash-bound immutable inputs: EOL translation is forbidden.
benchmarks/fixtures/** -text
benchmarks/fixtures/**/*.svg text eol=lf
benchmarks/fixtures/**/*.json text eol=lf
# Case05 evidence is produced by LF writers; pin bytes so hashes survive checkout.
# (Historic cases 01-04 keep their committed CRLF SVG blobs untouched.)
examples/svg-seeded/05-sting-autophagy/** text eol=lf
examples/reference-only/05-sting-autophagy-reference-only/** text eol=lf
