{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-autofigure/schemas/figure-spec.schema.json",
  "title": "AI AutoFigure render-ready figure specification",
  "type": "object",
  "required": [
    "schema_version",
    "mode",
    "source",
    "perception",
    "coordinate_system",
    "canvas",
    "measurement_dpi",
    "elements",
    "edges",
    "formulas",
    "uncertainties"
  ],
  "properties": {
    "schema_version": {"enum": ["3.0", "4.0"]},
    "mode": {"enum": ["reconstruct_1to1", "publication_normalize"]},
    "source": {
      "type": "object",
      "required": ["path", "sha256", "width_px", "height_px", "pixel_format", "user_confirmed"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "width_px": {"type": "integer", "minimum": 1},
        "height_px": {"type": "integer", "minimum": 1},
        "pixel_format": {"type": "string", "minLength": 1},
        "user_confirmed": {"const": true}
      },
      "additionalProperties": true
    },
    "perception": {
      "type": "object",
      "required": ["manifest_path", "manifest_sha256", "review_receipt_path", "review_receipt_sha256"],
      "properties": {
        "manifest_path": {"type": "string", "minLength": 1},
        "manifest_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "review_receipt_path": {"type": "string", "minLength": 1},
        "review_receipt_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
      },
      "additionalProperties": true
    },
    "geometry": {
      "description": "Optional binding to Phase-1 observation-only geometry evidence. Presence never grants Drawer authority.",
      "type": "object",
      "required": ["manifest_path", "manifest_sha256"],
      "properties": {
        "manifest_path": {"type": "string", "minLength": 1},
        "manifest_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "coordinate_system": {
      "type": "object",
      "required": ["origin", "unit", "bbox_order"],
      "properties": {
        "origin": {"const": "top-left"},
        "unit": {"const": "source_pixel"},
        "bbox_order": {"const": ["x", "y", "w", "h"]}
      },
      "additionalProperties": false
    },
    "canvas": {
      "type": "object",
      "required": [
        "width_px",
        "height_px",
        "background",
        "background_evidence",
        "pptx_path",
        "pptx_sha256",
        "slide_width_emu",
        "slide_height_emu"
      ],
      "properties": {
        "width_px": {"type": "integer", "minimum": 1},
        "height_px": {"type": "integer", "minimum": 1},
        "background": {"type": "string", "pattern": "^#[A-Fa-f0-9]{6}$"},
        "background_evidence": {"enum": ["measured_reference", "intentional_deviation"]},
        "background_reason": {"type": "string", "minLength": 1},
        "pptx_path": {"type": "string", "minLength": 1},
        "pptx_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "slide_width_emu": {"type": "integer", "minimum": 1},
        "slide_height_emu": {"type": "integer", "minimum": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"background_evidence": {"const": "intentional_deviation"}}},
          "then": {"required": ["background_reason"]}
        }
      ],
      "additionalProperties": true
    },
    "measurement_dpi": {"type": "number", "exclusiveMinimum": 0},
    "policy_profile": {"enum": ["standard", "strict"]},
    "elements": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/element"}
    },
    "edges": {
      "type": "array",
      "items": {"$ref": "#/$defs/edge"}
    },
    "formulas": {
      "type": "array",
      "items": {"$ref": "#/$defs/formula"}
    },
    "uncertainties": {
      "type": "array",
      "items": {"$ref": "#/$defs/uncertainty"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"schema_version": {"const": "4.0"}},
        "required": ["schema_version"]
      },
      "then": {
        "required": ["policy_profile"],
        "properties": {
          "elements": {
            "items": {
              "allOf": [
                {"required": ["render_strategy", "geometry_source", "review_risk"]},
                {"not": {"properties": {"type": {"const": "micro_asset"}}, "required": ["type"]}}
              ]
            }
          },
          "edges": {
            "items": {"required": ["representation", "arrow_class", "style"]}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"schema_version": {"const": "3.0"}},
        "required": ["schema_version"]
      },
      "then": {
        "properties": {
          "elements": {"items": {"required": ["strategy"]}}
        }
      }
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "bbox": {
      "type": "object",
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"},
        "w": {"type": "number", "exclusiveMinimum": 0},
        "h": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "source_evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["target_visual", "local_ocr", "consensus_auto", "user_confirmed", "source_text", "latex", "manual_measurement", "calibrated_geometry"]
      }
    },
    "margin": {
      "oneOf": [
        {"type": "number", "minimum": 0},
        {
          "type": "object",
          "properties": {
            "left": {"type": "number", "minimum": 0},
            "right": {"type": "number", "minimum": 0},
            "top": {"type": "number", "minimum": 0},
            "bottom": {"type": "number", "minimum": 0}
          },
          "additionalProperties": false
        }
      ]
    },
    "text_style": {
      "type": "object",
      "required": ["font_family"],
      "properties": {
        "font_family": {"type": "string", "minLength": 1},
        "font_path": {"type": "string", "minLength": 1},
        "font_size_px": {"type": "number", "exclusiveMinimum": 0},
        "font_size_pt": {"type": "number", "exclusiveMinimum": 0},
        "margin_px": {"$ref": "#/$defs/margin"},
        "wrap": {"type": "boolean"},
        "line_spacing": {"type": "number", "minimum": 0.5, "maximum": 3.0},
        "rotation_deg": {"type": "number"}
      },
      "anyOf": [
        {"required": ["font_size_px"]},
        {"required": ["font_size_pt"]}
      ],
      "additionalProperties": true
    },
    "formula_style": {
      "type": "object",
      "required": ["color"],
      "properties": {
        "font_size_px": {"type": "number", "exclusiveMinimum": 0},
        "font_size_pt": {"type": "number", "exclusiveMinimum": 0},
        "color": {"type": "string", "pattern": "^#[A-Fa-f0-9]{6}$"},
        "margin_px": {"$ref": "#/$defs/margin"},
        "rotation_deg": {"type": "number"}
      },
      "anyOf": [
        {"required": ["font_size_px"]},
        {"required": ["font_size_pt"]}
      ],
      "additionalProperties": false
    },
    "element": {
      "type": "object",
      "required": [
        "id",
        "type",
        "parent_id",
        "bbox",
        "z_index",
        "semantic_role",
        "source_evidence",
        "disposition",
        "confidence",
        "uncertainty_px",
        "allowed_overlap",
        "status"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
        "type": {
          "enum": ["background", "panel", "group", "text", "shape", "native_shape", "formula", "icon", "plot", "legend", "reference_atomic_asset", "micro_asset", "manual_asset_slot"]
        },
        "bbox": {"$ref": "#/$defs/bbox"},
        "parent_id": {"type": ["string", "null"]},
        "region_id": {"type": ["string", "null"]},
        "z_index": {"type": "integer", "minimum": 0},
        "semantic_role": {"type": "string", "minLength": 1},
        "source_evidence": {"$ref": "#/$defs/source_evidence"},
        "disposition": {"enum": ["CONFIRMED", "INCONCLUSIVE", "UNREADABLE", "NOT_TEXT"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "uncertainty_px": {"type": "number", "minimum": 0},
        "strategy": {"enum": ["native_editable", "manual_asset_slot", "source_ambiguity"]},
        "render_strategy": {
          "enum": ["native_required", "native_preferred", "reference_atomic_asset", "manual_asset_slot", "source_ambiguity"]
        },
        "geometry_source": {"$ref": "#/$defs/geometry_source"},
        "review_risk": {"enum": ["critical", "ordinary"]},
        "allowed_overlap": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "status": {"enum": ["pending", "mapped", "verified", "intentional_deviation", "blocked"]},
        "text": {"type": "string"},
        "text_style": {"$ref": "#/$defs/text_style"},
        "criticality": {"enum": ["critical", "ordinary"]},
        "perception_candidate_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^T[0-9]{4}$"}
        },
        "formula_id": {"type": "string", "minLength": 1},
        "formula_style": {"$ref": "#/$defs/formula_style"},
        "slot_contract": {"$ref": "#/$defs/slot_contract"},
        "asset_binding": {"$ref": "#/$defs/reference_atomic_asset_binding"},
        "content_runs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/text_run"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "text"}}, "required": ["type"]},
          "then": {
            "required": ["text_style", "criticality", "perception_candidate_ids"],
            "oneOf": [
              {"required": ["text"], "not": {"required": ["content_runs"]}},
              {"required": ["content_runs"], "not": {"required": ["text"]}}
            ]
          }
        },
        {
          "if": {"properties": {"type": {"const": "formula"}}, "required": ["type"]},
          "then": {"required": ["formula_id", "formula_style"]}
        },
        {
          "if": {"properties": {"type": {"const": "manual_asset_slot"}}, "required": ["type"]},
          "then": {
            "required": ["slot_contract"],
            "properties": {"strategy": {"const": "manual_asset_slot"}},
            "not": {
              "anyOf": [
                {"required": ["text"]},
                {"required": ["content_runs"]},
                {"required": ["formula_id"]}
              ]
            }
          }
        },
        {
          "if": {"properties": {"strategy": {"const": "manual_asset_slot"}}, "required": ["strategy"]},
          "then": {"properties": {"type": {"const": "manual_asset_slot"}}}
        },
        {
          "if": {"properties": {"type": {"const": "reference_atomic_asset"}}, "required": ["type"]},
          "then": {
            "required": ["asset_binding", "render_strategy"],
            "properties": {"render_strategy": {"const": "reference_atomic_asset"}},
            "not": {
              "anyOf": [
                {"required": ["text"]},
                {"required": ["content_runs"]},
                {"required": ["formula_id"]}
              ]
            }
          }
        },
        {
          "if": {"properties": {"type": {"enum": ["text", "formula"]}}, "required": ["type"]},
          "then": {"properties": {"render_strategy": {"const": "native_required"}}}
        }
      ],
      "additionalProperties": true
    },
    "slot_contract": {
      "type": "object",
      "required": [
        "slot_id",
        "mode",
        "classification",
        "required_content",
        "forbidden_content",
        "bbox_source",
        "aspect_ratio",
        "fit_mode",
        "rotation_deg",
        "replacement_object_name",
        "native_capability_audit",
        "preview"
      ],
      "properties": {
        "slot_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
        "mode": {
          "enum": ["empty", "reference_preview", "user_filled", "backfilled_verified"]
        },
        "classification": {
          "enum": ["creative_raster", "brand_asset", "user_keep_as_image"]
        },
        "required_content": {"type": "string", "minLength": 1},
        "forbidden_content": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "text",
              "formula",
              "connector",
              "axis_or_legend",
              "panel_border",
              "quantitative_evidence"
            ]
          }
        },
        "bbox_source": {"$ref": "#/$defs/bbox"},
        "aspect_ratio": {"type": "number", "exclusiveMinimum": 0},
        "fit_mode": {"enum": ["contain", "cover"]},
        "rotation_deg": {"const": 0},
        "replacement_object_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*_REPLACE_ME$"
        },
        "native_capability_audit": {"$ref": "#/$defs/native_capability_audit"},
        "preview": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/reference_preview_binding"}
          ]
        },
        "filled_asset": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/slot_asset_binding"}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "reference_preview"}}, "required": ["mode"]},
          "then": {"properties": {"preview": {"$ref": "#/$defs/reference_preview_binding"}}},
          "else": {"properties": {"preview": {"type": "null"}}}
        },
        {
          "if": {"properties": {"mode": {"enum": ["user_filled", "backfilled_verified"]}}, "required": ["mode"]},
          "then": {"required": ["filled_asset"], "properties": {"filled_asset": {"$ref": "#/$defs/slot_asset_binding"}}},
          "else": {"properties": {"filled_asset": {"type": "null"}}}
        }
      ],
      "additionalProperties": false
    },
    "slot_asset_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "width_px", "height_px", "rights_basis", "provenance"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "width_px": {"type": "integer", "minimum": 1},
        "height_px": {"type": "integer", "minimum": 1},
        "rights_basis": {"type": "string", "minLength": 1},
        "provenance": {"enum": ["user_supplied", "verified_source_backfill"]}
      }
    },
    "native_capability_audit": {
      "type": "object",
      "required": [
        "backend",
        "outcome",
        "tested_families",
        "reason_codes",
        "assessed_at_utc"
      ],
      "properties": {
        "backend": {"enum": ["powerpoint", "drawio"]},
        "outcome": {"const": "SLOT_REQUIRED"},
        "tested_families": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "primitive_shapes",
              "freeform_paths",
              "builtin_icons",
              "native_text",
              "native_office_math",
              "native_chart"
            ]
          }
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "PHOTOGRAPHIC_CONTINUOUS_TONE",
              "COMPLEX_TEXTURE",
              "BRAND_FIDELITY",
              "USER_KEEP_AS_IMAGE",
              "NONSEPARABLE_OCCLUSION"
            ]
          }
        },
        "estimated_native_shape_count": {"type": "integer", "minimum": 0},
        "backend_capabilities_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "assessed_at_utc": {"type": "string", "format": "date-time"},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "reference_preview_binding": {
      "type": "object",
      "required": [
        "manifest_path",
        "manifest_sha256",
        "decomposition_mode",
        "decomposition_note",
        "contains_reconstructable_text",
        "contains_formula",
        "contains_connector",
        "contains_axis_or_legend",
        "contains_panel_border",
        "contains_quantitative_evidence",
        "visible_disclosure_required",
        "disclosure_text",
        "qa_similarity_masked",
        "native_coverage_credit",
        "replace_before_approval"
      ],
      "properties": {
        "manifest_path": {"type": "string", "minLength": 1},
        "manifest_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "decomposition_mode": {"enum": ["ATOMIC", "MINIMALLY_NONSEPARABLE"]},
        "decomposition_note": {"type": "string", "minLength": 1},
        "contains_reconstructable_text": {"const": false},
        "contains_formula": {"const": false},
        "contains_connector": {"const": false},
        "contains_axis_or_legend": {"const": false},
        "contains_panel_border": {"const": false},
        "contains_quantitative_evidence": {"const": false},
        "visible_disclosure_required": {"const": true},
        "disclosure_text": {"const": "REFERENCE PREVIEW — REPLACE ME"},
        "qa_similarity_masked": {"const": true},
        "native_coverage_credit": {"const": false},
        "replace_before_approval": {"const": true}
      },
      "additionalProperties": false
    },
    "geometry_source": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["designer_authored", "target_visual", "manual_measurement", "calibrated_phase1"]},
        "manifest_path": {"type": "string", "minLength": 1},
        "manifest_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "observation_id": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "calibration_receipt_path": {"type": "string", "minLength": 1},
        "calibration_receipt_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "calibrated_phase1"}}, "required": ["kind"]},
          "then": {
            "required": ["manifest_path", "manifest_sha256", "observation_id", "confidence", "calibration_receipt_path", "calibration_receipt_sha256"]
          }
        }
      ],
      "additionalProperties": false
    },
    "reference_atomic_asset_binding": {
      "type": "object",
      "required": [
        "receipt_path", "receipt_sha256", "asset_path", "asset_sha256",
        "source_bbox", "decoded_width_px", "decoded_height_px", "atomicity",
        "semantic_object_count", "contains_reconstructable_text", "contains_formula",
        "contains_axis_or_legend", "contains_panel_border", "contains_quantitative_evidence",
        "transform", "rights_basis"
      ],
      "properties": {
        "receipt_path": {"type": "string", "minLength": 1},
        "receipt_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "asset_path": {"type": "string", "minLength": 1},
        "asset_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "source_bbox": {"$ref": "#/$defs/bbox"},
        "decoded_width_px": {"type": "integer", "minimum": 1},
        "decoded_height_px": {"type": "integer", "minimum": 1},
        "atomicity": {"enum": ["ISOLATED", "SEPARABLE"]},
        "semantic_object_count": {"const": 1},
        "contains_reconstructable_text": {"const": false},
        "contains_formula": {"const": false},
        "contains_axis_or_legend": {"const": false},
        "contains_panel_border": {"const": false},
        "contains_quantitative_evidence": {"const": false},
        "mask_path": {"type": "string", "minLength": 1},
        "mask_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "transform": {
          "type": "object",
          "required": ["preserve_aspect_ratio", "resampled_file", "rotation_deg", "translate_x_px", "translate_y_px"],
          "properties": {
            "preserve_aspect_ratio": {"const": true},
            "resampled_file": {"const": false},
            "rotation_deg": {"type": "number"},
            "translate_x_px": {"type": "number"},
            "translate_y_px": {"type": "number"}
          },
          "additionalProperties": false
        },
        "rights_basis": {"type": "string", "minLength": 1}
      },
      "dependentRequired": {
        "mask_path": ["mask_sha256"],
        "mask_sha256": ["mask_path"]
      },
      "additionalProperties": false
    },
    "text_run": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "text"],
          "properties": {
            "kind": {"const": "text"},
            "text": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "formula_id"],
          "properties": {
            "kind": {"const": "math"},
            "formula_id": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      ]
    },
    "edge": {
      "type": "object",
      "required": [
        "id",
        "from",
        "to",
        "source_anchor",
        "target_anchor",
        "route",
        "meaning",
        "clearance_px",
        "allowed_crossings",
        "allowed_edge_crossings"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "source_anchor": {"enum": ["top", "right", "bottom", "left", "center", "free"]},
        "target_anchor": {"enum": ["top", "right", "bottom", "left", "center", "free"]},
        "route": {"enum": ["straight", "orthogonal", "polyline", "curve"]},
        "allow_self_loop": {"type": "boolean", "default": false},
        "meaning": {"enum": ["data_flow", "control_flow", "interaction", "feedback", "association"]},
        "clearance_px": {"type": "number", "minimum": 0},
        "allowed_crossings": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "allowed_edge_crossings": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "style": {"type": "object"},
        "representation": {"enum": ["native_connector", "native_line_chain", "reference_atomic_asset"]},
        "arrow_class": {"enum": ["thin_connector", "filled_native", "style_asset"]},
        "visual_asset_id": {"type": "string", "minLength": 1},
        "source_point": {"$ref": "#/$defs/point_object"},
        "target_point": {"$ref": "#/$defs/point_object"},
        "via": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["x", "y"],
            "properties": {"x": {"type": "number"}, "y": {"type": "number"}},
            "additionalProperties": false
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"source_anchor": {"const": "free"}}},
          "then": {"required": ["source_point"]}
        },
        {
          "if": {"properties": {"target_anchor": {"const": "free"}}},
          "then": {"required": ["target_point"]}
        },
        {
          "if": {"properties": {"route": {"enum": ["orthogonal", "polyline"]}}},
          "then": {"required": ["via"], "properties": {"via": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"route": {"const": "straight"}}},
          "then": {"properties": {"via": {"maxItems": 0}}}
        },
        {
          "if": {"properties": {"representation": {"const": "reference_atomic_asset"}}, "required": ["representation"]},
          "then": {"required": ["visual_asset_id"], "properties": {"arrow_class": {"const": "style_asset"}}}
        }
      ],
      "additionalProperties": true
    },
    "formula": {
      "type": "object",
      "required": [
        "id",
        "element_id",
        "canonical_latex",
        "latex_sha256",
        "mode",
        "render_kind",
        "fallback_policy",
        "converter_receipt_path",
        "converter_receipt_sha256",
        "source_evidence",
        "disposition"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "element_id": {"type": "string", "minLength": 1},
        "canonical_latex": {"type": "string", "minLength": 1},
        "latex_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "mode": {"enum": ["inline", "display"]},
        "render_kind": {"const": "native_office_math"},
        "fallback_policy": {"const": "strict_no_raster_no_svg"},
        "converter_receipt_path": {"type": "string", "minLength": 1},
        "converter_receipt_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "source_evidence": {"$ref": "#/$defs/source_evidence"},
        "disposition": {"const": "CONFIRMED"},
        "perception_candidate_id": {
          "type": "string",
          "pattern": "^T[0-9]{4}$"
        }
      },
      "additionalProperties": true
    },
    "uncertainty": {
      "type": "object",
      "required": ["id", "element_id", "critical", "description"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "element_id": {"type": "string", "minLength": 1},
        "critical": {"const": false},
        "description": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "point_object": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"}
      },
      "additionalProperties": false
    }
  }
}
