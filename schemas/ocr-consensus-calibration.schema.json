{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-autofigure/schemas/ocr-consensus-calibration.schema.json",
  "title": "OCR ordinary-text consensus calibration receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "document_type", "status", "fixture", "policy_profile",
    "algorithm_id", "selected_min_confidence", "metrics"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "document_type": {"const": "OCR_CONSENSUS_CALIBRATION_RECEIPT"},
    "status": {"enum": ["PASS", "FAIL"]},
    "fixture": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "version"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "policy_profile": {"enum": ["standard", "strict"]},
    "algorithm_id": {"const": "ordinary_text_consensus_v1"},
    "selected_min_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["fixture_count", "eligible_count", "selected_count", "correct_count", "precision"],
      "properties": {
        "fixture_count": {"type": "integer", "minimum": 1},
        "eligible_count": {"type": "integer", "minimum": 1},
        "selected_count": {"type": "integer", "minimum": 1},
        "correct_count": {"type": "integer", "minimum": 0},
        "precision": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
