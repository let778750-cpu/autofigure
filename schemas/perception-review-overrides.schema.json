{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-autofigure/schemas/perception-review-overrides.schema.json",
  "title": "AI AutoFigure source-text perception review overrides",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_type",
    "manifest_sha256",
    "source_sha256",
    "source_authority_sha256",
    "source_locator",
    "items"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "document_type": {"const": "PERCEPTION_REVIEW_SOURCE_TEXT_OVERRIDES"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "source_sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "source_authority_sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "source_locator": {"type": "string", "minLength": 1},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "status", "confirmed_text", "detail", "rationale"],
        "properties": {
          "candidate_id": {"type": "string", "pattern": "^T[0-9]{4}$"},
          "status": {"enum": ["CONFIRMED", "CORRECTED", "NOT_TEXT"]},
          "confirmed_text": {"type": ["string", "null"]},
          "detail": {"type": "string", "minLength": 1},
          "rationale": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"enum": ["CONFIRMED", "CORRECTED"]}}},
            "then": {"properties": {"confirmed_text": {"type": "string", "minLength": 1}}}
          },
          {
            "if": {"properties": {"status": {"const": "NOT_TEXT"}}},
            "then": {"properties": {"confirmed_text": {"type": "null"}}}
          }
        ]
      }
    }
  }
}
