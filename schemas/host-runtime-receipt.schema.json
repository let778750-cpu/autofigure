{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-autofigure.local/schemas/host-runtime-receipt.schema.json",
  "title": "AI AutoFigure host CV runtime validation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_at_utc",
    "status",
    "context",
    "bindings",
    "runtime",
    "isolation",
    "packages",
    "modules",
    "smoke_tests",
    "checks"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "created_at_utc": { "type": "string", "format": "date-time" },
    "status": { "enum": ["PASS", "FAIL"] },
    "context": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["run_id", "source_sha256"],
          "properties": {
            "run_id": { "type": "null" },
            "source_sha256": { "type": "null" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["run_id", "source_sha256"],
          "properties": {
            "run_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{5,127}$"
            },
            "source_sha256": { "$ref": "#/$defs/sha256" }
          }
        }
      ]
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_config", "requirements", "receipt_schema", "validator"],
      "properties": {
        "runtime_config": { "$ref": "#/$defs/fileBinding" },
        "requirements": { "$ref": "#/$defs/fileBinding" },
        "receipt_schema": { "$ref": "#/$defs/fileBinding" },
        "validator": { "$ref": "#/$defs/fileBinding" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_id",
        "configured_root",
        "resolved_root",
        "expected_python",
        "python_executable",
        "expected_python_version",
        "python_version",
        "prefix",
        "base_prefix"
      ],
      "properties": {
        "runtime_id": { "type": "string", "minLength": 1 },
        "configured_root": { "type": "string", "minLength": 1 },
        "resolved_root": { "type": "string", "minLength": 1 },
        "expected_python": { "type": "string", "minLength": 1 },
        "python_executable": { "type": "string", "minLength": 1 },
        "expected_python_version": { "type": "string", "minLength": 1 },
        "python_version": { "type": "string", "minLength": 1 },
        "prefix": { "type": "string", "minLength": 1 },
        "base_prefix": { "type": "string", "minLength": 1 }
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "isolated",
        "ignore_environment",
        "no_user_site",
        "safe_path"
      ],
      "properties": {
        "required": { "const": true },
        "isolated": { "type": "boolean" },
        "ignore_environment": { "type": "boolean" },
        "no_user_site": { "type": "boolean" },
        "safe_path": { "type": "boolean" }
      }
    },
    "packages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "installed_inventory",
        "installed_inventory_sha256",
        "opencv_distributions",
        "forbidden_distributions_present",
        "duplicate_distributions"
      ],
      "properties": {
        "required": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/requiredPackage" }
        },
        "installed_inventory": {
          "type": "array",
          "items": { "$ref": "#/$defs/installedPackage" }
        },
        "installed_inventory_sha256": { "$ref": "#/$defs/sha256" },
        "opencv_distributions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "forbidden_distributions_present": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "duplicate_distributions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/moduleRecord" }
    },
    "smoke_tests": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/check" }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/check" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9A-F]{64}$"
    },
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size_bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "requiredPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distribution", "expected_version", "actual_version", "passed"],
      "properties": {
        "distribution": { "type": "string", "minLength": 1 },
        "expected_version": { "type": "string", "minLength": 1 },
        "actual_version": { "type": ["string", "null"] },
        "passed": { "type": "boolean" }
      }
    },
    "installedPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distribution", "version"],
      "properties": {
        "distribution": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "moduleRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distribution", "module", "origin", "within_prefix", "imported"],
      "properties": {
        "distribution": { "type": "string", "minLength": 1 },
        "module": { "type": "string", "minLength": 1 },
        "origin": { "type": ["string", "null"] },
        "within_prefix": { "type": "boolean" },
        "imported": { "type": "boolean" }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "passed", "detail"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "passed": { "type": "boolean" },
        "detail": { "type": "string" }
      }
    }
  }
}
