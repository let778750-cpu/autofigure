{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-autofigure/schemas/reference-preview-asset.schema.json",
  "title": "AI AutoFigure deterministic reference-preview crop receipt",
  "type": "object",
  "required": [
    "schema_version",
    "document_type",
    "status",
    "created_at_utc",
    "source",
    "crop",
    "asset",
    "policy"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "document_type": {"const": "REFERENCE_PREVIEW_ASSET"},
    "status": {"const": "PREVIEW_ONLY_REPLACE_BEFORE_APPROVAL"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "required": ["path", "sha256", "width_px", "height_px", "pixel_format", "user_confirmed"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "width_px": {"type": "integer", "minimum": 1},
        "height_px": {"type": "integer", "minimum": 1},
        "pixel_format": {"type": "string", "minLength": 1},
        "user_confirmed": {"const": true}
      },
      "additionalProperties": false
    },
    "crop": {
      "type": "object",
      "required": ["bbox_source", "padding_px", "resampling", "lossless"],
      "properties": {
        "bbox_source": {"$ref": "#/$defs/integer_bbox"},
        "padding_px": {"const": 0},
        "resampling": {"const": "NONE_EXACT_PIXELS"},
        "lossless": {"const": true}
      },
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "required": ["path", "sha256", "size_bytes", "width_px", "height_px", "pixel_format", "media_type"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "width_px": {"type": "integer", "minimum": 1},
        "height_px": {"type": "integer", "minimum": 1},
        "pixel_format": {"type": "string", "minLength": 1},
        "media_type": {"const": "image/png"}
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": [
        "derived_from_current_reference",
        "presentation_use",
        "visible_disclosure_required",
        "qa_similarity_masked",
        "native_coverage_credit",
        "replace_before_approval"
      ],
      "properties": {
        "derived_from_current_reference": {"const": true},
        "presentation_use": {"const": "PREVIEW_ONLY"},
        "visible_disclosure_required": {"const": true},
        "qa_similarity_masked": {"const": true},
        "native_coverage_credit": {"const": false},
        "replace_before_approval": {"const": true}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "integer_bbox": {
      "type": "object",
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": {"type": "integer", "minimum": 0},
        "y": {"type": "integer", "minimum": 0},
        "w": {"type": "integer", "minimum": 1},
        "h": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  }
}
