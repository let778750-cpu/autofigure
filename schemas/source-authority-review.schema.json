{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-autofigure/schemas/source-authority-review.schema.json",
  "title": "AI AutoFigure source-authority human-review package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_type",
    "status",
    "run_id",
    "policy",
    "authority",
    "source",
    "renderer",
    "counts",
    "items",
    "outputs",
    "review_decision"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "document_type": {"const": "SOURCE_AUTHORITY_REVIEW_PACKAGE"},
    "status": {"const": "READY_FOR_HUMAN_REVIEW"},
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{5,127}$"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_unchanged",
        "overlay_is_diagnostic_only",
        "approval_required_for_freeze"
      ],
      "properties": {
        "authority_unchanged": {"const": true},
        "overlay_is_diagnostic_only": {"const": true},
        "approval_required_for_freeze": {"const": true}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "authority_id", "status", "item_count"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "authority_id": {"type": "string", "minLength": 1},
        "status": {"const": "DRAFT"},
        "item_count": {"type": "integer", "minimum": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "width_px", "height_px", "pixel_format"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "width_px": {"type": "integer", "minimum": 1},
        "height_px": {"type": "integer", "minimum": 1},
        "pixel_format": {"type": "string", "minLength": 1}
      }
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "script_sha256", "schema_sha256", "scale"],
      "properties": {
        "name": {"const": "source-authority-review-overlay"},
        "version": {"const": "1.0.0"},
        "script_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "schema_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "scale": {"type": "integer", "minimum": 1, "maximum": 4}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "confirmed", "inconclusive", "manual_assets", "relations"],
      "properties": {
        "total": {"type": "integer", "minimum": 1},
        "confirmed": {"type": "integer", "minimum": 0},
        "inconclusive": {"type": "integer", "minimum": 0},
        "manual_assets": {"type": "integer", "minimum": 0},
        "relations": {"type": "integer", "minimum": 0}
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "authority_item_id",
          "subject_id",
          "kind",
          "disposition",
          "criticality",
          "bbox_source",
          "review_value",
          "notes"
        ],
        "properties": {
          "authority_item_id": {"type": "string", "pattern": "^AUTH-[0-9]{4}$"},
          "subject_id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["TEXT", "FORMULA", "SEMANTIC_REGION", "RELATION", "MANUAL_ASSET"]},
          "disposition": {"enum": ["CONFIRMED", "INCONCLUSIVE", "NOT_APPLICABLE"]},
          "criticality": {"enum": ["critical", "ordinary"]},
          "bbox_source": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["x", "y", "w", "h"],
                "properties": {
                  "x": {"type": "number", "minimum": 0},
                  "y": {"type": "number", "minimum": 0},
                  "w": {"type": "number", "exclusiveMinimum": 0},
                  "h": {"type": "number", "exclusiveMinimum": 0}
                }
              },
              {"type": "null"}
            ]
          },
          "review_value": {"type": ["string", "null"]},
          "notes": {"type": "string"}
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overlay"],
      "properties": {
        "overlay": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "sha256", "width_px", "height_px", "pixel_format"],
          "properties": {
            "file": {"const": "authority-overlay.png"},
            "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
            "width_px": {"type": "integer", "minimum": 1},
            "height_px": {"type": "integer", "minimum": 1},
            "pixel_format": {"const": "RGB"}
          }
        }
      }
    },
    "review_decision": {"type": "null"}
  }
}
