{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-autofigure.local/schemas/agent-vision.schema.json",
  "title": "AI AutoFigure agent-vision response and stamped observations",
  "description": "Native-vision observations filled by the outer agent (AGENT_VISION_RESPONSE) and the validator-stamped form (AGENT_VISION_OBSERVATIONS). Observations are candidate evidence only: no text or coordinate authority is ever granted, and self-consistency is computed by tooling, never self-declared.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_type",
    "created_at_utc",
    "task_package",
    "agent",
    "policy",
    "queries"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "document_type": {
      "enum": ["AGENT_VISION_RESPONSE", "AGENT_VISION_OBSERVATIONS"]
    },
    "created_at_utc": { "type": "string", "format": "date-time" },
    "task_package": { "$ref": "#/$defs/taskPackageBinding" },
    "agent": { "$ref": "#/$defs/agent" },
    "policy": { "$ref": "#/$defs/policy" },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/queryResponse" }
    },
    "validation": { "$ref": "#/$defs/validation" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "document_type": { "const": "AGENT_VISION_OBSERVATIONS" }
        },
        "required": ["document_type"]
      },
      "then": { "required": ["validation"] }
    },
    {
      "if": {
        "properties": {
          "document_type": { "const": "AGENT_VISION_RESPONSE" }
        },
        "required": ["document_type"]
      },
      "then": { "properties": { "validation": { "type": "null" } } }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9A-F]{64}$"
    },
    "runIdPattern": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{5,127}$"
    },
    "taskPackageBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "run_id", "source_sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "run_id": { "$ref": "#/$defs/runIdPattern" },
        "source_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "declared_model",
        "multi_pass_independence_attested"
      ],
      "properties": {
        "role": { "const": "OUTER_AGENT_NATIVE_VISION" },
        "declared_model": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 128 },
            { "type": "null" }
          ]
        },
        "multi_pass_independence_attested": {
          "type": "boolean"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vlm_is_ground_truth",
        "coordinates_advisory_only",
        "may_not_invent_text",
        "agent_must_observe_images_directly",
        "observations_are_candidate_evidence_only"
      ],
      "properties": {
        "vlm_is_ground_truth": { "const": false },
        "coordinates_advisory_only": { "const": true },
        "may_not_invent_text": { "const": true },
        "agent_must_observe_images_directly": { "const": true },
        "observations_are_candidate_evidence_only": { "const": true }
      }
    },
    "integerBox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x0", "y0", "x1", "y1"],
      "properties": {
        "x0": { "type": "integer", "minimum": 0 },
        "y0": { "type": "integer", "minimum": 0 },
        "x1": { "type": "integer", "minimum": 1 },
        "y1": { "type": "integer", "minimum": 1 }
      }
    },
    "panelProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "panel_id",
        "bbox_source",
        "kind",
        "reading_order_rank",
        "reading_flow_hint",
        "label_text_guess"
      ],
      "properties": {
        "panel_id": { "type": "string", "pattern": "^P[0-9]{3}$" },
        "bbox_source": { "$ref": "#/$defs/integerBox" },
        "kind": {
          "enum": ["PANEL", "AXIS", "LEGEND", "TITLE_BLOCK", "DIAGRAM_GROUP"]
        },
        "reading_order_rank": { "type": "integer", "minimum": 1, "maximum": 24 },
        "reading_flow_hint": {
          "oneOf": [
            { "enum": ["L2R", "R2L", "T2B", "B2T", "MIXED"] },
            { "type": "null" }
          ]
        },
        "label_text_guess": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 512 },
            { "type": "null" }
          ]
        }
      }
    },
    "structureObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["panels", "diagram_types"],
      "properties": {
        "panels": {
          "type": "array",
          "minItems": 0,
          "maxItems": 24,
          "items": { "$ref": "#/$defs/panelProposal" }
        },
        "diagram_types": {
          "type": "array",
          "minItems": 0,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        }
      }
    },
    "conflictObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "selected_index",
        "confidence_self_rating",
        "reason_code"
      ],
      "properties": {
        "decision": {
          "oneOf": [
            { "enum": ["SELECT", "REJECT_ALL"] },
            { "type": "null" }
          ]
        },
        "selected_index": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "null" }
          ]
        },
        "confidence_self_rating": {
          "oneOf": [
            { "enum": ["HIGH", "MEDIUM", "LOW"] },
            { "type": "null" }
          ]
        },
        "reason_code": {
          "oneOf": [
            {
              "enum": [
                "ILLEGIBLE",
                "AMBIGUOUS",
                "SPURIOUS_DETECTION",
                "CONTEXT_MISMATCH"
              ]
            },
            { "type": "null" }
          ]
        }
      }
    },
    "formulaSample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_index", "latex"],
      "properties": {
        "sample_index": { "type": "integer", "minimum": 1, "maximum": 3 },
        "latex": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "formulaObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["samples", "self_consistency"],
      "properties": {
        "samples": {
          "type": "array",
          "minItems": 0,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/formulaSample" }
        },
        "self_consistency": {
          "oneOf": [
            { "enum": ["SELF_CONSISTENT_K3", "INCONSISTENT"] },
            { "type": "null" }
          ]
        }
      }
    },
    "missScanObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contains_text", "text_hypothesis", "reason_code"],
      "properties": {
        "contains_text": {
          "oneOf": [{ "type": "boolean" }, { "type": "null" }]
        },
        "text_hypothesis": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 512 },
            { "type": "null" }
          ]
        },
        "reason_code": {
          "oneOf": [
            { "enum": ["GRAPHICS_ONLY", "LINE_OR_BORDER", "NOISE", "OTHER"] },
            { "type": "null" }
          ]
        }
      }
    },
    "queryResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_id",
        "task_type",
        "observation_status",
        "structure",
        "conflict",
        "formula",
        "miss_scan"
      ],
      "properties": {
        "query_id": { "type": "string", "pattern": "^V[0-9]{4}$" },
        "task_type": {
          "enum": [
            "STRUCTURE_GLOBAL",
            "CONFLICT_ARBITRATION",
            "FORMULA_TRANSCRIPTION",
            "MISS_SCAN"
          ]
        },
        "observation_status": {
          "enum": ["OBSERVED", "NOT_OBSERVABLE"]
        },
        "structure": {
          "oneOf": [
            { "$ref": "#/$defs/structureObservation" },
            { "type": "null" }
          ]
        },
        "conflict": {
          "oneOf": [
            { "$ref": "#/$defs/conflictObservation" },
            { "type": "null" }
          ]
        },
        "formula": {
          "oneOf": [
            { "$ref": "#/$defs/formulaObservation" },
            { "type": "null" }
          ]
        },
        "miss_scan": {
          "oneOf": [
            { "$ref": "#/$defs/missScanObservation" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "task_type": { "const": "STRUCTURE_GLOBAL" },
              "observation_status": { "const": "OBSERVED" }
            },
            "required": ["task_type", "observation_status"]
          },
          "then": {
            "properties": {
              "structure": {
                "type": "object",
                "required": ["panels", "diagram_types"]
              },
              "conflict": { "const": null },
              "formula": { "const": null },
              "miss_scan": { "const": null }
            }
          }
        },
        {
          "if": {
            "properties": {
              "task_type": { "const": "CONFLICT_ARBITRATION" },
              "observation_status": { "const": "OBSERVED" }
            },
            "required": ["task_type", "observation_status"]
          },
          "then": {
            "properties": {
              "conflict": {
                "type": "object",
                "required": [
                  "decision",
                  "selected_index",
                  "confidence_self_rating",
                  "reason_code"
                ]
              },
              "structure": { "const": null },
              "formula": { "const": null },
              "miss_scan": { "const": null }
            }
          }
        },
        {
          "if": {
            "properties": {
              "task_type": { "const": "FORMULA_TRANSCRIPTION" },
              "observation_status": { "const": "OBSERVED" }
            },
            "required": ["task_type", "observation_status"]
          },
          "then": {
            "properties": {
              "formula": {
                "type": "object",
                "required": ["samples", "self_consistency"]
              },
              "structure": { "const": null },
              "conflict": { "const": null },
              "miss_scan": { "const": null }
            }
          }
        },
        {
          "if": {
            "properties": {
              "task_type": { "const": "MISS_SCAN" },
              "observation_status": { "const": "OBSERVED" }
            },
            "required": ["task_type", "observation_status"]
          },
          "then": {
            "properties": {
              "miss_scan": {
                "type": "object",
                "required": ["contains_text", "text_hypothesis", "reason_code"]
              },
              "structure": { "const": null },
              "conflict": { "const": null },
              "formula": { "const": null }
            }
          }
        },
        {
          "if": {
            "properties": {
              "observation_status": { "const": "NOT_OBSERVABLE" }
            },
            "required": ["observation_status"]
          },
          "then": {
            "properties": {
              "structure": { "const": null },
              "conflict": { "const": null },
              "formula": {
                "anyOf": [
                  { "const": null },
                  {
                    "type": "object",
                    "properties": { "samples": { "maxItems": 0 } },
                    "required": ["samples", "self_consistency"]
                  }
                ]
              },
              "miss_scan": { "const": null }
            }
          }
        }
      ]
    },
    "validation": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "validated_at_utc",
            "task_package_sha256",
            "checks_passed"
          ],
          "properties": {
            "validated_at_utc": { "type": "string", "format": "date-time" },
            "task_package_sha256": { "$ref": "#/$defs/sha256" },
            "checks_passed": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "TASK_PACKAGE_SCHEMA",
                  "TASK_PACKAGE_CROP_HASHES",
                  "RESPONSE_SCHEMA",
                  "TASK_PACKAGE_BINDING",
                  "QUERY_COVERAGE_EXACT",
                  "COORDINATES_IN_CANVAS",
                  "PANEL_LIMIT",
                  "CONFLICT_SELECTION_BOUNDS",
                  "FORMULA_SELF_CONSISTENCY_COMPUTED"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
